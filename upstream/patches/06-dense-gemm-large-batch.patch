+        GGMLQuantizationType.Q8_0,
+    ],
+)
+@torch.inference_mode()
+def test_dense_gemm_dispatch(
+    monkeypatch: pytest.MonkeyPatch,
+    num_tokens: int,
+    hidden_size: int,
+    dtype: torch.dtype,
+    quant_type: GGMLQuantizationType,
+):
+    """Batches at or above the threshold skip the fused kernels entirely,
+    smaller ones keep them, and both agree with the dense reference."""
+    seed_everything(0)
+    min_rows = 1024
+    monkeypatch.setattr(gguf_linear, "_DENSE_GEMM_MIN_ROWS", min_rows)
+
+    calls: list[str] = []
+
+    def spy(name: str):
+        original = getattr(ops, name)
+
+        def wrapped(*args, **kwargs):
+            calls.append(name)
+            return original(*args, **kwargs)
+
+        monkeypatch.setattr(ops, name, wrapped)
+
+    for name in ("ggml_dequantize", "ggml_mul_mat_vec_a8", "ggml_mul_mat_a8"):
+        spy(name)
+
+    tensors = get_gguf_sample_tensors(hidden_size, quant_type)
+    x = torch.rand((num_tokens, hidden_size), dtype=dtype, device="cuda")
+    for tensor in tensors:
+        calls.clear()
+        weight = torch.tensor(dequantize(tensor.data, quant_type), device="cuda").to(
+            dtype
+        )
+        ref_output = x @ weight.T
+
+        weight = torch.tensor(tensor.data, device="cuda")
+        output = gguf_linear._fused_mul_mat_gguf(x, weight, quant_type).to(dtype)
+
+        if num_tokens >= min_rows:
+            assert calls == ["ggml_dequantize"]
+        else:
+            assert "ggml_dequantize" not in calls
+
+        atols = {torch.half: 1, torch.bfloat16: 5, torch.float: 1.2}
+        rtols = {torch.half: 1e-1, torch.bfloat16: 1e4, torch.float: 2e1}
+        torch.testing.assert_close(
+            output, ref_output, atol=atols[dtype], rtol=rtols[dtype]
+        )
+
+
+def test_dense_gemm_dispatch_off_by_default():
+    assert gguf_linear._DENSE_GEMM_MIN_ROWS == 0
+
+
