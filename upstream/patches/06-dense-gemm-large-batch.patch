+# Row count at or above which a quantized GEMM is run as "dequantize, then a
+# dense matmul" instead of through the fused mmq kernel. The fused kernels win
+# when the batch is small (decode), where the step is bound by reading the
+# packed weight; a prefill chunk has thousands of rows and is compute bound,
+# where the dense GEMM is several times faster. 0 (the default) keeps the
+# fused kernels for every batch size.
+_DENSE_GEMM_MIN_ROWS = max(0, int(os.environ.get("VLLM_GGUF_DENSE_GEMM_MIN_ROWS", "0")))
+
+
+def _dequantize_mul_mat_gguf(
+    x: torch.Tensor, weight: torch.Tensor, weight_type: int
+) -> torch.Tensor:
+    block_size, type_size = gguf.GGML_QUANT_SIZES[weight_type]
+    shape = (weight.shape[0], weight.shape[1] // type_size * block_size)
+    weight = ops.ggml_dequantize(weight, weight_type, *shape, x.dtype)
+    return x @ weight.T
+
 
